{
  "name": "@lms/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test:validation": "tsx --test tests/validation.test.ts",
    "admin:create": "npx --yes auth@1.7.20 create-admin --config ./src/config/auth.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:ping": "tsx scripts/ping.ts",
    "auth:migrate": "npx --yes auth@1.7.20 migrate --config ./src/config/auth.ts",
    "test:schema": "node --test tests/postgres-schema.test.mjs"
  },
  "dependencies": {
    "better-auth": "1.7.20",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "zod": "^4.0.0",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "@types/pg": "^8.15.5"
  }
}
